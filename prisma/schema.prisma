generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String                   @id @default(cuid())
  fullName                String
  email                   String                   @unique
  phoneNumber             String?                  @unique
  userName                String?                  @unique
  type                    String                   @default("user")
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  assessments             Assessment[]
  cases                   Case[]
  claims                  Claim[]
  discussions             Discussion[]
  evidence                Evidence[]
  opinions                Opinion[]
  sessions                Session[]
  sources                 Source[]
  evidenceValidations     EvidenceValidation[]
  userAddress             UserAddress?
  userCredential          UserCredential?
  userProfile             UserProfile?
  reportsFiled            Report[]                 @relation("ReportedBy")
  reportsReviewed         Report[]                 @relation("ReviewedBy")
  caseReactions           CaseReaction[]
  caseViews               CaseView[]
  organizationsCreated    Organization[]           @relation("OrganizationCreator")
  organizationMemberships OrganizationMembership[]
  organizationInvitations OrganizationInvitation[]
  userJoinRequests        OrganizationJoinRequest[] @relation("UserJoinRequests")
  reviewedJoinRequests    OrganizationJoinRequest[] @relation("ReviewerJoinRequests")
  officialResponses       OfficialResponse[]
  caseFollows             CaseFollow[]
  caseBookmarks           CaseBookmark[]
  organizationFollows     OrganizationFollow[]
  feedbackSignals         UserFeedbackSignal[]
  claimUpdates            ClaimUpdate[]
  caseUpdates             CaseUpdate[]

  @@map("users")
}

model Session {
  id             String    @id @default(cuid())
  userId         String
  refreshTokenId String    @unique
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model UserAddress {
  id        String   @id @default(cuid())
  userId    String   @unique
  address   String
  city      String
  state     String
  zipCode   String
  country   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@map("user_addresses")
}

model UserProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  profilePicture String?
  coverPicture   String?
  bio            String?
  location       String?
  website        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id])

  @@map("user_profiles")
}

model UserCredential {
  id           String   @id @default(cuid())
  userId       String   @unique
  password     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  refreshToken String?
  user         User     @relation(fields: [userId], references: [id])

  @@map("user_credentials")
}

model Case {
  isAnonymous                Boolean            @default(false)
  canUserCreateClaim         Boolean            @default(true)
  canUserCreateClaimEvidence Boolean            @default(true)
  canUserCreateClaimUpdate   Boolean            @default(true)
  id                         String             @id @default(cuid())
  title                      String
  titleHtml                  String             @default("") @db.Text
  location                   String
  authorId                   String
  caseStatus                 String
  visibility                 String             @default("PUBLIC")
  organizationId             String?
  lastActivityAt             DateTime           @default(now())
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt
  medias                     CaseMedia[]
  author                     User               @relation(fields: [authorId], references: [id])
  organization               Organization?      @relation("OrganizationCases", fields: [organizationId], references: [id], onDelete: SetNull)
  claims                     Claim[]
  discussions                Discussion[]
  evidence                   CaseEvidence[]
  sources                    CaseSource[]
  tags                       CaseTag[]
  caseReactions              CaseReaction[]
  caseViews                  CaseView[]
  officialResponses          OfficialResponse[]
  follows                    CaseFollow[]
  bookmarks                  CaseBookmark[]
  updates                    CaseUpdate[]

  @@index([authorId])
  @@index([organizationId])
  @@index([createdAt])
  @@index([lastActivityAt])
  @@map("cases")
}

model CaseView {
  id         String   @id @default(cuid())
  caseId     String
  userId     String?
  visitorKey String?
  createdAt  DateTime @default(now())

  case Case  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([caseId, createdAt])
  @@index([userId, createdAt])
  @@map("case_views")
}

model Claim {
  isAnonymous Boolean @default(false)
  id          String  @id @default(cuid())
  title       String

  claimType   String?
  caseId      String
  createdBy   String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  claimStatus ClaimStatus     @default(SHOW)
  currentState ClaimState?    @default(PROPOSED)
  assessments Assessment[]
  evidence    ClaimEvidence[]
  medias      ClaimMedia[]
  sources     ClaimSource[]
  updates     ClaimUpdate[]
  case        Case            @relation(fields: [caseId], references: [id])
  creator     User            @relation(fields: [createdBy], references: [id])
  discussions Discussion[]

  @@index([caseId])
  @@index([createdBy])
  @@map("claims")
}

model ClaimMedia {
  claimId String
  mediaId String
  order   Int
  claim   Claim  @relation(fields: [claimId], references: [id])
  media   Media  @relation(fields: [mediaId], references: [id])

  @@id([claimId, mediaId])
  @@map("claim_medias")
}

model Evidence {
  isAnonymous Boolean              @default(false)
  id          String               @id @default(cuid())
  title       String
  type        String
  submittedBy String
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  claims      ClaimEvidence[]
  cases       CaseEvidence[]
  submitter   User                 @relation(fields: [submittedBy], references: [id])
  medias      EvidenceMedia[]
  validations EvidenceValidation[]
  claimUpdates ClaimUpdateEvidence[]
  caseUpdates  CaseUpdateEvidence[]

  @@index([submittedBy])
  @@map("evidence")
}

model ClaimEvidence {
  claimId      String
  evidenceId   String
  relationship String
  createdAt    DateTime @default(now())
  claim        Claim    @relation(fields: [claimId], references: [id])
  evidence     Evidence @relation(fields: [evidenceId], references: [id])

  @@id([claimId, evidenceId])
  @@index([evidenceId])
  @@map("claim_evidence")
}

model Media {
  id                    String                 @id @default(cuid())
  url                   String
  type                  String
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  caseMedias            CaseMedia[]
  claimMedias           ClaimMedia[]
  evidenceMedias        EvidenceMedia[]
  opinionMedias         OpinionMedia[]
  organizationDocuments OrganizationDocument[]

  @@map("medias")
}

model CaseMedia {
  caseId  String
  mediaId String
  order   Int
  case    Case   @relation(fields: [caseId], references: [id])
  media   Media  @relation(fields: [mediaId], references: [id])

  @@id([caseId, mediaId])
  @@map("case_medias")
}

model EvidenceMedia {
  evidenceId String
  mediaId    String
  order      Int
  evidence   Evidence @relation(fields: [evidenceId], references: [id])
  media      Media    @relation(fields: [mediaId], references: [id])

  @@id([evidenceId, mediaId])
  @@index([mediaId])
  @@map("evidence_medias")
}

model Source {
  isAnonymous        Boolean         @default(false)
  id                 String          @id @default(cuid())
  title              String
  sourceLocation     String
  sourceDate         DateTime?
  externalSourceType String
  externalSourceName String
  externalLinks      String[]
  createdBy          String
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  claims             ClaimSource[]
  cases              CaseSource[]
  opinions           OpinionSource[]
  claimUpdates       ClaimUpdateSource[]
  caseUpdates        CaseUpdateSource[]
  creator            User            @relation(fields: [createdBy], references: [id])

  @@index([createdBy])
  @@map("sources")
}

model ClaimSource {
  claimId      String
  sourceId     String
  relationship String
  createdAt    DateTime @default(now())
  claim        Claim    @relation(fields: [claimId], references: [id])
  source       Source   @relation(fields: [sourceId], references: [id])

  @@id([claimId, sourceId])
  @@index([sourceId])
  @@map("claim_sources")
}

model CaseEvidence {
  caseId       String
  evidenceId   String
  relationship String
  createdAt    DateTime @default(now())
  case         Case     @relation(fields: [caseId], references: [id])
  evidence     Evidence @relation(fields: [evidenceId], references: [id])

  @@id([caseId, evidenceId])
  @@index([evidenceId])
  @@map("case_evidence")
}

model CaseSource {
  caseId       String
  sourceId     String
  relationship String
  createdAt    DateTime @default(now())
  case         Case     @relation(fields: [caseId], references: [id])
  source       Source   @relation(fields: [sourceId], references: [id])

  @@id([caseId, sourceId])
  @@index([sourceId])
  @@map("case_sources")
}

model Assessment {
  id          String          @id @default(cuid())
  reason      String?
  claimId     String
  userId      String
  assessment  AssessmentValue
  isAnonymous Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  claim       Claim           @relation(fields: [claimId], references: [id])
  user        User            @relation(fields: [userId], references: [id])

  @@unique([claimId, userId])
  @@index([userId])
  @@map("assessment")
}

model Discussion {
  isAnonymous Boolean      @default(false)
  id          String       @id @default(cuid())
  content     String
  userId      String
  parentId    String?
  caseId      String
  claimId     String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  case        Case         @relation(fields: [caseId], references: [id])
  claim       Claim?       @relation(fields: [claimId], references: [id])
  parent      Discussion?  @relation("DiscussionReplies", fields: [parentId], references: [id])
  replies     Discussion[] @relation("DiscussionReplies")
  user        User         @relation(fields: [userId], references: [id])

  @@index([caseId])
  @@index([claimId])
  @@index([userId])
  @@index([parentId])
  @@map("discussion")
}

model Opinion {
  isAnonymous Boolean         @default(false)
  id          String          @id @default(cuid())
  content     String
  value       String?
  targetType  TargetType
  targetId    String
  authorId    String
  parentId    String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  medias      OpinionMedia[]
  sources     OpinionSource[]
  author      User            @relation(fields: [authorId], references: [id])
  parent      Opinion?        @relation("OpinionReplies", fields: [parentId], references: [id])
  replies     Opinion[]       @relation("OpinionReplies")

  @@index([targetType, targetId])
  @@index([authorId])
  @@index([parentId])
  @@map("opinions")
}

model OpinionMedia {
  opinionId String
  mediaId   String
  order     Int
  media     Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  opinion   Opinion @relation(fields: [opinionId], references: [id], onDelete: Cascade)

  @@id([opinionId, mediaId])
  @@map("opinion_medias")
}

model OpinionSource {
  opinionId String
  sourceId  String
  createdAt DateTime @default(now())
  opinion   Opinion  @relation(fields: [opinionId], references: [id], onDelete: Cascade)
  source    Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@id([opinionId, sourceId])
  @@map("opinion_sources")
}

enum ClaimStatus {
  HIDDEN
  SHOW
  BLOCKED
}

enum AssessmentValue {
  SUPPORTED
  PARTIALLY_SUPPORTED
  INSUFFICIENT_EVIDENCE
  CONTRADICTED
  DISPUTED
}

enum TargetType {
  CASE
  CLAIM
  EVIDENCE
  SOURCE
  OPINION
  DISCUSSION
  MEDIA
}

model Report {
  isAnonymous Boolean          @default(false)
  id          String           @id @default(cuid())
  targetType  TargetType
  targetId    String
  reason      ReportReason
  description String?
  reportedBy  String
  status      ReportStatus     @default(PENDING)
  reviewedBy  String?
  reviewedAt  DateTime?
  resolution  ReportResolution @default(NO_ACTION)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  reporter User  @relation("ReportedBy", fields: [reportedBy], references: [id])
  reviewer User? @relation("ReviewedBy", fields: [reviewedBy], references: [id])

  @@index([targetType, targetId])
  @@index([status])
  @@map("reports")
}

enum ReportReason {
  SPAM
  HARASSMENT
  ABUSIVE_CONTENT
  MISLEADING_INFORMATION
  COPYRIGHT
  PRIVACY
  INAPPROPRIATE_CONTENT
  DUPLICATE
  OTHER
}

enum ReportStatus {
  PENDING
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

enum ReportResolution {
  NO_ACTION
  HIDE_CONTENT
  RESTORE_CONTENT
  WARN_USER
  REMOVE_CONTENT
}

model Tag {
  id             String    @id @default(cuid())
  name           String
  normalizedName String    @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  cases          CaseTag[]

  @@map("tags")
}

model CaseTag {
  caseId    String
  tagId     String
  createdAt DateTime @default(now())
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([caseId, tagId])
  @@index([tagId])
  @@map("case_tags")
}

model EvidenceValidation {
  id         String                  @id @default(cuid())
  evidenceId String
  userId     String
  value      EvidenceValidationValue
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt
  evidence   Evidence                @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  user       User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([evidenceId, userId])
  @@index([evidenceId])
  @@index([userId])
  @@map("evidence_validation")
}

enum EvidenceValidationValue {
  VALID
  INVALID
}

model CaseReaction {
  id        String            @id @default(cuid())
  caseId    String
  userId    String
  value     CaseReactionValue
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  case      Case              @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([caseId, userId])
  @@index([caseId])
  @@index([userId])
  @@map("case_reactions")
}

enum CaseReactionValue {
  SUPPORT
  OPPOSE
}

// --- ORGANIZATION SYSTEM ---

enum OrganizationVisibility {
  PUBLIC
  PRIVATE
}

enum OrganizationVerificationStatus {
  UNVERIFIED
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
  SUSPENDED
}

enum OrganizationStatus {
  PENDING
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum OrganizationRole {
  OWNER
  ADMIN
  MODERATOR
  REPRESENTATIVE
  MEMBER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

model Organization {
  id               String  @id @default(cuid())
  name             String
  slug             String  @unique
  description      String? @db.Text
  organizationType String

  // The Three Separated Concepts
  visibility         OrganizationVisibility         @default(PUBLIC)
  verificationStatus OrganizationVerificationStatus @default(UNVERIFIED)
  status             OrganizationStatus

  // Media
  logoUrl  String?
  coverUrl String?

  // Contact / Location
  website  String?
  email    String?
  phone    String?
  address  String?
  location String?

  // Categorization
  category         String?
  categoryKeywords String[]

  // Moderation / Verification Metadata
  rejectionReason  String?
  suspensionReason String?
  verifiedAt       DateTime?
  verifiedBy       String?
  suspendedAt      DateTime?
  suspendedBy      String?

  // Auditing
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  creator           User                     @relation("OrganizationCreator", fields: [createdBy], references: [id])
  memberships       OrganizationMembership[]
  invitations       OrganizationInvitation[]
  joinRequests      OrganizationJoinRequest[]
  officialResponses OfficialResponse[]
  verificationDocs  OrganizationDocument[]
  cases             Case[]                   @relation("OrganizationCases")
  followers         OrganizationFollow[]

  @@map("organizations")
}

enum MembershipModerationStatus {
  ACTIVE
  RESTRICTED
  SUSPENDED
  BANNED
}

model OrganizationMembership {
  id               String                     @id @default(cuid())
  organizationId   String
  userId           String
  role             OrganizationRole           @default(MEMBER)
  moderationStatus MembershipModerationStatus @default(ACTIVE)
  moderatedAt      DateTime?
  moderatedBy      String?
  moderationReason String?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  invitedBy        String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_memberships")
}

model OrganizationInvitation {
  id             String           @id @default(cuid())
  organizationId String
  email          String
  invitedBy      String
  role           OrganizationRole @default(MEMBER)
  status         InvitationStatus @default(PENDING)
  expiresAt      DateTime
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter      User         @relation(fields: [invitedBy], references: [id])

  @@index([email])
  @@map("organization_invitations")
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model OrganizationJoinRequest {
  id              String            @id @default(cuid())
  organizationId  String
  userId          String
  status          JoinRequestStatus @default(PENDING)
  message         String?           @db.Text
  reviewedBy      String?
  reviewedAt      DateTime?
  rejectionReason String?           @db.Text
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation("UserJoinRequests", fields: [userId], references: [id], onDelete: Cascade)
  reviewer     User?        @relation("ReviewerJoinRequests", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@unique([organizationId, userId])
  @@map("organization_join_requests")
}

model OrganizationDocument {
  organizationId String
  mediaId        String
  documentType   String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  media        Media        @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([organizationId, mediaId])
  @@map("organization_documents")
}

model OfficialResponse {
  id               String   @id @default(cuid())
  organizationId   String
  caseId           String
  representativeId String
  content          String   @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  case           Case         @relation(fields: [caseId], references: [id], onDelete: Cascade)
  representative User         @relation(fields: [representativeId], references: [id])

  @@index([caseId])
  @@map("official_responses")
}

model CaseFollow {
  id        String   @id @default(cuid())
  caseId    String
  userId    String
  createdAt DateTime @default(now())

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([caseId, userId])
  @@index([userId])
  @@map("case_follows")
}

model CaseBookmark {
  id        String   @id @default(cuid())
  caseId    String
  userId    String
  createdAt DateTime @default(now())

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([caseId, userId])
  @@index([userId])
  @@map("case_bookmarks")
}

model OrganizationFollow {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_follows")
}

model UserFeedbackSignal {
  id         String   @id @default(cuid())
  userId     String
  targetType String   // "CASE" | "ORGANIZATION"
  targetId   String
  action     String   // "HIDE" | "NOT_INTERESTED" | "MUTE"
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId])
  @@index([userId])
  @@map("user_feedback_signals")
}

// --- CLAIM UPDATES & TIMELINE SYSTEM ---

enum ClaimState {
  PROPOSED
  SUPPORTED
  PARTIALLY_SUPPORTED
  INSUFFICIENT_EVIDENCE
  CHALLENGED
  CONTRADICTED
  DISPUTED
  WITHDRAWN
  SUPERSEDED
}

enum ClaimUpdateType {
  GENERAL_UPDATE
  INFORMATION_ADDED
  EVIDENCE_ADDED
  SOURCE_ADDED
  STATE_CHANGED
  CLAIM_REVISED
  CLAIM_CLARIFIED
  CHALLENGED
  WITHDRAWN
  SUPERSEDED
}

model ClaimUpdate {
  id            String          @id @default(cuid())
  claimId       String
  content       String          @db.Text
  previousState ClaimState?
  newState      ClaimState?
  updateType    ClaimUpdateType @default(GENERAL_UPDATE)
  createdBy     String
  isAnonymous   Boolean         @default(false)
  isDeleted     Boolean         @default(false)
  isVerified    Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  claim         Claim                 @relation(fields: [claimId], references: [id], onDelete: Cascade)
  author        User                  @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  evidence      ClaimUpdateEvidence[]
  sources       ClaimUpdateSource[]

  @@index([claimId, createdAt])
  @@index([createdBy])
  @@map("claim_updates")
}

model ClaimUpdateEvidence {
  updateId   String
  evidenceId String
  createdAt  DateTime @default(now())

  update   ClaimUpdate @relation(fields: [updateId], references: [id], onDelete: Cascade)
  evidence Evidence    @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@id([updateId, evidenceId])
  @@index([evidenceId])
  @@map("claim_update_evidence")
}

model ClaimUpdateSource {
  updateId  String
  sourceId  String
  createdAt DateTime @default(now())

  update ClaimUpdate @relation(fields: [updateId], references: [id], onDelete: Cascade)
  source Source      @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@id([updateId, sourceId])
  @@index([sourceId])
  @@map("claim_update_sources")
}

model CaseUpdate {
  id             String          @id @default(cuid())
  caseId         String
  content        String          @db.Text
  previousStatus String?
  newStatus      String?
  updateType     ClaimUpdateType @default(GENERAL_UPDATE)
  createdBy      String
  isAnonymous    Boolean         @default(false)
  isDeleted      Boolean         @default(false)
  isVerified     Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  case     Case                 @relation(fields: [caseId], references: [id], onDelete: Cascade)
  author   User                 @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  evidence CaseUpdateEvidence[]
  sources  CaseUpdateSource[]

  @@index([caseId, createdAt])
  @@index([createdBy])
  @@map("case_updates")
}

model CaseUpdateEvidence {
  updateId   String
  evidenceId String
  createdAt  DateTime @default(now())

  update   CaseUpdate @relation(fields: [updateId], references: [id], onDelete: Cascade)
  evidence Evidence   @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@id([updateId, evidenceId])
  @@index([evidenceId])
  @@map("case_update_evidence")
}

model CaseUpdateSource {
  updateId  String
  sourceId  String
  createdAt DateTime @default(now())

  update CaseUpdate @relation(fields: [updateId], references: [id], onDelete: Cascade)
  source Source     @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@id([updateId, sourceId])
  @@index([sourceId])
  @@map("case_update_sources")
}



